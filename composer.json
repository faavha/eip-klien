{
    "name": "fmipa/eip-klien",
    "description": "Klien EIP Core FMIPA UNS untuk aplikasi Laravel: login SSO (OIDC + PKCE), API master/akses, peran, tombol Aplikasi, banding peran.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Fmipa\\EipKlien\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fmipa\\EipKlien\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fmipa\\EipKlien\\EipKlienServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
